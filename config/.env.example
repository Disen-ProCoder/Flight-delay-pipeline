# ============================================================
# Flight Delay Pipeline — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git (it's in .gitignore).
# ============================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flight_warehouse
DB_USER=pipeline_user
DB_PASSWORD=your_secure_password_here

# Full connection string (auto-built from above in config.py)
# DATABASE_URL=postgresql://pipeline_user:password@localhost:5432/flight_warehouse

# --- AviationStack API ---
# Free tier: 100 requests/month
# Sign up at: https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=your_api_key_here

# --- BTS Data Settings ---
BTS_DATA_DIR=./data/raw/bts
PROCESSED_DATA_DIR=./data/processed

# --- Airflow (if using) ---
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://pipeline_user:your_secure_password_here@localhost:5432/airflow_db

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs
